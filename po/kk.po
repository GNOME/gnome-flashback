#: data/directories/X-GNOME-Flashback-Settings-System.directory.desktop.in:4
msgid "Change system-wide settings (affects all users)"
msgstr "Жалпы жүйелік параметрлерді өзгерту (барлық пайдаланушыларға әсер етеді)"

#: data/keybindings/50-gnome-flashback-screenshots.xml:6
#: data/schemas/org.gnome.gnome-flashback.gschema.xml:67
msgid "Screenshots"
msgstr "Скриншоттар"

#: data/keybindings/50-gnome-flashback-screenshots.xml:10
msgid "Save a screenshot to $PICTURES"
msgstr "Скриншотты $PICTURES бумасына сақтау"

#: data/keybindings/50-gnome-flashback-screenshots.xml:14
msgid "Save a screenshot of a window to $PICTURES"
msgstr "Терезе скриншотын $PICTURES бумасына сақтау"

#: data/keybindings/50-gnome-flashback-screenshots.xml:18
msgid "Save a screenshot of an area to $PICTURES"
msgstr "Аймақ скриншотын $PICTURES бумасына сақтау"

#: data/keybindings/50-gnome-flashback-screenshots.xml:21
#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:23
msgid "Copy a screenshot to clipboard"
msgstr "Скриншотты алмасу буферіне көшіру"

#: data/keybindings/50-gnome-flashback-screenshots.xml:24
#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:29
msgid "Copy a screenshot of a window to clipboard"
msgstr "Терезе скриншотын алмасу буферіне көшіру"

#: data/keybindings/50-gnome-flashback-screenshots.xml:27
#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:35
msgid "Copy a screenshot of an area to clipboard"
msgstr "Аймақ скриншотын алмасу буферіне көшіру"

#: data/keybindings/50-gnome-flashback-screenshots.xml:30
msgid "Record a short screencast"
msgstr "Қысқа экран жазбасын түсіру"

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:5
msgid "a11y-keyboard"
msgstr "a11y-keyboard"

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:10
msgid "Audio device selection"
msgstr "Аудио құрылғыны таңдау"

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:11
msgid ""
"If set to true, then GNOME Flashback application will be used to provide the "
"audio device selection dialog."
msgstr ""
"Егер ақиқат болса, аудио құрылғыны таңдау сұхбат терезесін ұсыну үшін GNOME "
"Flashback қолданбасы қолданылады."

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:16
msgid "Automount manager"
msgstr "Автоматты тіркеу менеджері"

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:17
msgid ""
"If set to true, then GNOME Flashback application will be used to automount "
"removable media."
msgstr ""
"Егер ақиқат болса, алынбалы тасушыларды автоматты тіркеу үшін GNOME Flashback "
"қолданбасы қолданылады."

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:22
msgid "Desktop"
msgstr "Жұмыс үстелі"

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:27
msgid "End session dialog"
msgstr "Сеансты аяқтау сұхбат терезесі"

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:28
msgid ""
"If set to true, then GNOME Flashback application will be used to show the end "
"session dialog."
msgstr ""
"Егер ақиқат болса, сеансты аяқтау сұхбат терезесін көрсету үшін GNOME "
"Flashback қолданбасы қолданылады."

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:33
msgid "Input settings"
msgstr "Енгізу параметрлері"

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:38
msgid "Keyboard layouts and input methods"
msgstr "Пернетақта жаймалары және енгізу әдістері"

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:39
msgid ""
"If set to true, then GNOME Flashback application will be used to manage "
"keyboard layouts and input methods."
msgstr ""
"Егер ақиқат болса, пернетақта жаймалары мен енгізу әдістерін басқару үшін "
"GNOME Flashback қолданбасы қолданылады."

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:44
msgid "Notification daemon"
msgstr "Хабарландыру қызметі"

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:45
msgid ""
"If set to true, then GNOME Flashback application will be used to manage "
"notifications."
msgstr ""
"Егер ақиқат болса, хабарландыруларды басқару үшін GNOME Flashback қолданбасы "
"қолданылады."

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:50
msgid "Root background"
msgstr "Түбірлік фон"

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:55
msgid "Screencasts"
msgstr "Экран жазбалары"

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:56
msgid ""
"If set to true, then GNOME Flashback application will be used to record the "
"screen."
msgstr ""
"Егер ақиқат болса, экранды жазу үшін GNOME Flashback қолданбасы қолданылады."

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:61
msgid "Screensaver"
msgstr "Экран сақтағышы"

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:62
msgid ""
"If set to true, then GNOME Flashback application will be used as a screensaver."
msgstr ""
"Егер ақиқат болса, GNOME Flashback қолданбасы экран сақтағышы ретінде "
"қолданылады."

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:68
msgid ""
"If set to true, then GNOME Flashback application will be used to take "
"screenshots."
msgstr ""
"Егер ақиқат болса, скриншоттар түсіру үшін GNOME Flashback қолданбасы "
"қолданылады."

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:73
msgid "Shell"
msgstr "Қоршам"

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:74
msgid "If set to true, then GNOME Flashback application will be used as a shell."
msgstr ""
"Егер ақиқат болса, GNOME Flashback қолданбасы қоршам ретінде қолданылады."

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:79
msgid "Status Notifier Watcher"
msgstr "Status Notifier Watcher"

#: data/schemas/org.gnome.gnome-flashback.gschema.xml:80
msgid ""
"If set to true, then GNOME Flashback application will be used as Status "
"Notifier Watcher."
msgstr ""
"Егер ақиқат болса, GNOME Flashback қолданбасы Status Notifier Watcher ретінде "
"қолданылады."

#: data/schemas/org.gnome.gnome-flashback.desktop.gschema.xml:5
msgid "Draw desktop background"
msgstr "Жұмыс үстелі фонын салу"

#: data/schemas/org.gnome.gnome-flashback.desktop.gschema.xml:6
msgid "If set to true, then GNOME Flashback will draw the desktop background."
msgstr "Егер ақиқат болса, GNOME Flashback жұмыс үстелі фонын салады."

#: data/schemas/org.gnome.gnome-flashback.desktop.gschema.xml:11
msgid "Show desktop icons"
msgstr "Жұмыс үстелі таңбашаларын көрсету"

#: data/schemas/org.gnome.gnome-flashback.desktop.gschema.xml:12
msgid "If set to true, then GNOME Flashback will draw the icons on the desktop."
msgstr "Егер ақиқат болса, GNOME Flashback жұмыс үстелінде таңбашаларды салады."

#: data/schemas/org.gnome.gnome-flashback.desktop.background.gschema.xml:5
msgid "Fade the background on change"
msgstr "Фон өзгерген кезде баяу сөнуді қолдану"

#: data/schemas/org.gnome.gnome-flashback.desktop.background.gschema.xml:6
msgid ""
"If set to true, then fade effect will be used to change the desktop background."
msgstr ""
"Егер ақиқат болса, жұмыс үстелі фонын өзгерту үшін баяу сөну эффектісі "
"қолданылады."

#: data/schemas/org.gnome.gnome-flashback.desktop.icons.gschema.xml:5
msgid "Icon size"
msgstr "Таңбаша өлшемі"

#: data/schemas/org.gnome.gnome-flashback.desktop.icons.gschema.xml:6
msgid "The size of desktop icons."
msgstr "Жұмыс үстелі таңбашаларының өлшемі."

#: data/schemas/org.gnome.gnome-flashback.desktop.icons.gschema.xml:11
msgid "Placement"
msgstr "Орналастыру"

#: data/schemas/org.gnome.gnome-flashback.desktop.icons.gschema.xml:12
msgid ""
"Can be one of \"auto-arrange-icons\", \"align-icons-to-grid\" or \"free\". It "
"controls how icons are placed on desktop."
msgstr ""
"«auto-arrange-icons», «align-icons-to-grid» немесе «free» мәндерінің бірі "
"болуы мүмкін. Бұл таңбашалардың жұмыс үстелінде қалай орналасатынын басқарады."

#: data/schemas/org.gnome.gnome-flashback.desktop.icons.gschema.xml:17
msgid "Sort by"
msgstr "Келесі бойынша сұрыптау"

#: data/schemas/org.gnome.gnome-flashback.desktop.icons.gschema.xml:18
msgid ""
"Can be one of \"name\", \"date-modified\" or \"size\". It controls how icons "
"are sorted in \"auto-arrange-icons\" placement."
msgstr ""
"«name», «date-modified» немесе «size» мәндерінің бірі болуы мүмкін. Бұл «auto-"
"arrange-icons» орналасуында таңбашалардың қалай сұрыпталатынын басқарады."

#: data/schemas/org.gnome.gnome-flashback.desktop.icons.gschema.xml:24
msgid "Extra text width"
msgstr "Мәтіннің қосымша ені"

#: data/schemas/org.gnome.gnome-flashback.desktop.icons.gschema.xml:25
msgid "Extra width for icon text."
msgstr "Таңбаша мәтіні үшін қосымша ен."

#: data/schemas/org.gnome.gnome-flashback.desktop.icons.gschema.xml:31
msgid "Column spacing"
msgstr "Бағандар аралығы"

#: data/schemas/org.gnome.gnome-flashback.desktop.icons.gschema.xml:32
msgid "The amount of space between columns."
msgstr "Бағандар арасындағы бос орын мөлшері."

#: data/schemas/org.gnome.gnome-flashback.desktop.icons.gschema.xml:38
msgid "Row spacing"
msgstr "Жолдар аралығы"

#: data/schemas/org.gnome.gnome-flashback.desktop.icons.gschema.xml:39
msgid "The amount of space between rows."
msgstr "Жолдар арасындағы бос орын мөлшері."

#: data/schemas/org.gnome.gnome-flashback.desktop.icons.gschema.xml:44
msgid "Show home icon"
msgstr "Үй бумасы таңбашасын көрсету"

#: data/schemas/org.gnome.gnome-flashback.desktop.icons.gschema.xml:45
msgid ""
"If this is set to true, an icon linking to the home folder will be put on the "
"desktop."
msgstr ""
"Егер бұл ақиқат болса, жұмыс үстеліне үй бумасына сілтейтін таңбаша қойылады."

#: data/schemas/org.gnome.gnome-flashback.desktop.icons.gschema.xml:50
msgid "Show trash icon"
msgstr "Қоқыс шелегі таңбашасын көрсету"

#: data/schemas/org.gnome.gnome-flashback.desktop.icons.gschema.xml:51
msgid ""
"If this is set to true, an icon linking to the trash will be put on the "
"desktop."
msgstr ""
"Егер бұл ақиқат болса, жұмыс үстеліне қоқыс шелегіне сілтейтін таңбаша "
"қойылады."

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:5
msgid "Take a screenshot"
msgstr "Скриншот түсіру"

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:6
msgid "Binding to take a screenshot."
msgstr "Скриншот түсіруге арналған пернелер тіркесі."

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:11
msgid "Take a screenshot of a window"
msgstr "Терезе скриншотын түсіру"

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:12
msgid "Binding to take a screenshot of a window."
msgstr "Терезе скриншотын түсіруге арналған пернелер тіркесі."

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:17
msgid "Take a screenshot of an area"
msgstr "Аймақ скриншотын түсіру"

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:18
msgid "Binding to take a screenshot of an area."
msgstr "Аймақ скриншотын түсіруге арналған пернелер тіркесі."

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:24
msgid "Binding to copy a screenshot to clipboard."
msgstr "Скриншотты алмасу буферіне көшіруге арналған пернелер тіркесі."

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:30
msgid "Binding to copy a screenshot of a window to clipboard."
msgstr "Терезе скриншотын алмасу буферіне көшіруге арналған пернелер тіркесі."

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:36
msgid "Binding to copy a screenshot of an area to clipboard."
msgstr "Аймақ скриншотын алмасу буферіне көшіруге арналған пернелер тіркесі."

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:41
msgid "Record a short video of the screen"
msgstr "Экраннан қысқа видео жазу"

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:42
msgid "Binding to record a short video of the screen"
msgstr "Экраннан қысқа видео жазуға арналған пернелер тіркесі"

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:47
msgid "Screen brightness up"
msgstr "Экран жарықтығын арттыру"

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:48
msgid "Binding to increase the screen brightness."
msgstr "Экран жарықтығын арттыру пернелер үйлесімі."

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:53
msgid "Screen brightness up on current monitor"
msgstr "Ағымдағы мониторда экран жарықтығын арттыру"

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:54
msgid "Binding to increase the brightness of the monitor under the pointer."
msgstr "Курсор астындағы монитордың жарықтығын арттыру пернелер жарлығы."

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:59
msgid "Screen brightness down"
msgstr "Экран жарықтығын азайту"

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:60
msgid "Binding to decrease the screen brightness."
msgstr "Экран жарықтығын азайту пернелер жарлығы."

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:65
msgid "Screen brightness down on current monitor"
msgstr "Ағымдағы мониторда экран жарықтығын азайту"

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:66
msgid "Binding to decrease the brightness of the monitor under the pointer."
msgstr "Курсор астындағы монитордың жарықтығын азайту пернелер жарлығы."

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:71
msgid "Screen brightness cycle"
msgstr "Экран жарықтығын ауыстырып өту"

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:72
msgid "Binding to cycle the screen brightness."
msgstr "Экран жарықтығын ауыстырып өту пернелер жарлығы."

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:77
msgid "Screen brightness cycle on current monitor"
msgstr "Ағымдағы мониторда экран жарықтығын ауыстырып өту"

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:78
msgid "Binding to cycle the brightness of the monitor under the pointer."
msgstr "Курсор астындағы монитордың жарықтығын ауыстырып өту пернелер жарлығы."

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:83
msgid "Maximum length of screen recordings"
msgstr "Экран жазбаларының максималды ұзақтығы"

#: data/schemas/org.gnome.gnome-flashback.keybindings.gschema.xml:84
msgid ""
"The maximum length of single screen cast recordings in seconds or 0 for "
"unlimited"
msgstr ""
"Жеке экран жазбаларының максималды ұзақтығы секундпен немесе шектеусіз үшін 0"

#: data/schemas/org.gnome.gnome-flashback.notifications.gschema.xml:12
msgid "Location of the notifications"
msgstr "Хабарламалардың орны"

#: data/schemas/org.gnome.gnome-flashback.notifications.gschema.xml:13
msgid "The corner of the screen where notifications will be shown."
msgstr "Экранның хабарламалар көрсетілетін бұрышы."

#: data/schemas/org.gnome.gnome-flashback.system-indicators.input-sources.gschema.xml:5
msgid "Use IBus icon if available"
msgstr "Қолжетімді болса, IBus таңбашасын қолдану"

#: data/schemas/org.gnome.gnome-flashback.system-indicators.input-sources.gschema.xml:10
msgid "Icon background color"
msgstr "Таңбашаның фон түсі"

#: data/schemas/org.gnome.gnome-flashback.system-indicators.input-sources.gschema.xml:15
msgid "Icon foreground color"
msgstr "Таңбашаның алдыңғы түсі"

#: data/schemas/org.gnome.gnome-flashback.system-indicators.input-sources.gschema.xml:20
msgid "Icon font family"
