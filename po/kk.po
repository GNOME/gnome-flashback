#: data/directories/X-GNOME-Flashback-Science.directory.desktop.in:3
msgid "Science"
msgstr "Ғылым"

#: data/directories/X-GNOME-Flashback-Science.directory.desktop.in:4
msgid "Scientific applications"
msgstr "Ғылыми қолданбалар"

#: data/directories/X-GNOME-Flashback-Settings.directory.desktop.in:3
